/* Reset Geral de Estilos */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

:root {
    --verde-escuro: #1b4332;
    --verde-principal: #2d6a4f;
    --verde-claro: #52b788;
    --verde-fundo: #f4f9f6;
    --cinza-texto: #333d38;
    --branco: #ffffff;
}

body {
    background-color: var(--branco);
    color: var(--cinza-texto);
    line-height: 1.6;
}

.container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header & Menu */
header {
    background-color: var(--branco);
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 15px 0;
}

header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--verde-principal);
    display: flex;
    align-items: center;
    gap: 10px;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

nav ul li a {
    text-decoration: none;
    color: var(--cinza-texto);
    font-weight: 600;
    font-size: 1rem;
    transition: color 0.3s ease;
}

nav ul li a:hover {
    color: var(--verde-claro);
}

/* Banner Principal (Hero) */
.hero-section {
    height: 80vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    color: var(--branco);
}

.hero-conteudo {
    max-width: 700px;
}

.hero-conteudo h1 {
    font-size: 3.2rem;
    line-height: 1.2;
    margin-bottom: 20px;
    font-weight: 800;
}

.hero-conteudo p {
    font-size: 1.25rem;
    margin-bottom: 30px;
    opacity: 0.95;
}

.btn-principal {
    display: inline-block;
    background-color: var(--verde-claro);
    color: var(--branco);
    padding: 12px 30px;
    font-weight: bold;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.3s, transform 0.2s;
}

.btn-principal:hover {
    background-color: var(--verde-principal);
    transform: translateY(-2px);
}

/* Seção Sobre */
.secao-sobre {
    padding: 80px 0;
}

.grid-sobre {
    display: flex;
    align-items: center;
    gap: 40px;
}

.texto-sobre {
    flex: 1;
}

.texto-sobre h2 {
    font-size: 2.2rem;
    color: var(--verde-escuro);
    margin-bottom: 20px;
}

.texto-sobre h2 span {
    color: var(--verde-claro);
}

.texto-sobre p {
    font-size: 1.05rem;
    margin-bottom: 15px;
}

.texto-sobre p.destaque {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--verde-principal);
}

.imagem-sobre {
    flex: 1;
}

.imagem-sobre img {
    width: 100%;
    border-radius: 8px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
}

/* Seção Importância */
.secao-importancia {
    background-color: var(--verde-fundo);
    padding: 80px 0;
}

.titulo-centralizado {
    text-align: center;
    font-size: 2.2rem;
    color: var(--verde-escuro);
    margin-bottom: 50px;
}

.grid-cards {
    display: flex;
    gap: 25px;
}

.card-info {
    flex: 1;
    background: var(--branco);
    padding: 35px 25px;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    transition: transform 0.3s ease;
}

.card-info:hover {
    transform: translateY(-10px);
}

.icone-box {
    font-size: 2.5rem;
    color: var(--verde-principal);
    margin-bottom: 15px;
}

.card-info h3 {
    font-size: 1.3rem;
    color: var(--verde-escuro);
    margin-bottom: 12px;
}

/* Seção Como Utilizar */
.secao-utilizacao {
    padding: 80px 0;
}

.grid-utilidades {
    display: flex;
    gap: 20px;
}

.bloco-utilidade {
    flex: 1;
    background-color: var(--branco);
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
}

.bloco-utilidade img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.bloco-texto {
    padding: 20px;
}

.bloco-texto h4 {
    font-size: 1.2rem;
    color: var(--verde-escuro);
    margin-bottom: 10px;
}

/* Seção Interativa (Simulador) */
.secao-simulador {
    background-color: var(--verde-fundo);
    padding: 80px 0;
}

.painel-simulador {
    max-width: 600px;
    margin: 0 auto;
    background: var(--branco);
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.05);
    text-align: center;
}

.painel-simulador h2 {
    color: var(--verde-escuro);
    margin-bottom: 10px;
}

.painel-simulador p {
    font-size: 1rem;
    margin-bottom: 25px;
}

.controles-simulador {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 30px;
}

.controles-simulador input {
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 1rem;
    width: 60%;
    outline: none;
}

.controles-simulador input:focus {
    border-color: var(--verde-claro);
}

.controles-simulador button {
    padding: 12px 20px;
    background-color: var(--verde-principal);
    color: var(--branco);
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
}

.controles-simulador button:hover {
    background-color: var(--verde-escuro);
}

.resultado-painel {
    background-color: #f1fbf7;
    border-radius: 6px;
    padding: 20px;
    display: flex;
    justify-content: space-around;
}

.resultado-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
}

.resultado-item i {
    font-size: 1.8rem;
}

.text-verde {
    color: var(--verde-principal);
}

.escondido {
    display: none !important;
}

/* Rodapé */
footer {
    background-color: var(--verde-escuro);
    color: var(--branco);
    text-align: center;
    padding: 25px 0;
    font-size: 0.95rem;
}

/* Layout Responsivo para Celulares */
@media (max-width: 768px) {
    header .container, .grid-sobre, .grid-cards, .grid-utilidades, .controles-simulador, .resultado-painel {
        flex-direction: column;
        align-items: stretch;
    }
    nav ul {
        display: none; /* Simplificação do menu mobile */
    }
    .controles-simulador input {
        width: 100%;
    }
    .hero-conteudo h1 {
        font-size: 2.2rem;
    }
}